----------------------------------------------------------------------
local platformTop = OFFSET.Y - PLATFORM_DROP
local platform = Instance.new("Part")
platform.Name = "DaycarePlatform"
platform.Anchored = true
platform.Size = Vector3.new(2048, 8, 2048)
platform.Position = Vector3.new(200 + OFFSET.X, platformTop - 4, -31290 + OFFSET.Z)
platform.Material = Enum.Material.SmoothPlastic
platform.Color = Color3.fromRGB(60, 60, 64)
platform.TopSurface = Enum.SurfaceType.Smooth
platform.Parent = folder

----------------------------------------------------------------------
-- teleport to the map's spawn, plus a safety net if you somehow drop below it
----------------------------------------------------------------------
local spawnPos = (spawnCF or (Vector3.new(-63.289, 3.5, -31274.375) + OFFSET)) + Vector3.new(0, 5, 0)
local function toSpawn()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = CFrame.new(spawnPos)
    end
end
task.wait(0.5)
toSpawn()

local watchdog = RunService.Heartbeat:Connect(function()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and math.abs(root.Position.X - (200 + OFFSET.X)) < 1400
        and root.Position.Y < platformTop - 15 then
        toSpawn()
    end
end)

_G.DaycareMapCleanup = function()
    watchdog:Disconnect()
    if folder then folder:Destroy() end
    _G.DaycareMapCleanup = nil
end
print("[Daycare] built locally. Run _G.DaycareMapCleanup() to remove it.")
