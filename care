local spawnCF  -- spawn location used for the teleport

local function add(shape, rot, pos, size, mat, hex, model, o)
    o = o or {}
    local part = Instance.new(shape == "T" and "TrussPart" or "Part")
    local p = v3(pos) + OFFSET
    local r = ROT[rot]
    part.Anchored = true
    part.Size = v3(size)
    part.CFrame = CFrame.new(p.X, p.Y, p.Z, r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9])
    part.Material = MAT[mat]
    part.Color = Color3.fromRGB(tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16))
    part.Transparency = o.t or 0
    part.Reflectance = o.r or 0
    part.CanCollide = o.c ~= false
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Name = o.n or "Part"
    if o.m then
        local mesh = Instance.new("SpecialMesh")
        if o.m.wedge then
            mesh.MeshType = Enum.MeshType.Wedge
        else
            mesh.MeshType = Enum.MeshType.FileMesh
            mesh.MeshId = o.m.id
            if o.m.tex then mesh.TextureId = o.m.tex end
            mesh.Scale = v3(o.m.s)
        end
        mesh.Parent = part
    end
    if o.d then
        local d = Instance.new("Decal")
        d.Texture = o.d[1]
        d.Face = Enum.NormalId[o.d[2]]
        d.Parent = part
    end
    if o.light then
        local l = Instance.new("SurfaceLight")
        l.Brightness = 3 l.Range = 20 l.Color = Color3.new(1, 1, 1)
        l.Shadows = true l.Face = Enum.NormalId.Front l.Angle = 90
        l.Parent = part
    end
    if o.n == "SpawnLocation2" then spawnCF = p end
    part.Parent = modelFor(model)
end

