local modelCache = {}
local function modelFor(key)
    if not key then return folder end
    if not modelCache[key] then
        local m = Instance.new("Model")
        m.Name = MODELS[key]
        m.Parent = folder
        modelCache[key] = m
    end
    return modelCache[key]
end

local function v3(s)
    local a, b, c = s:match("([^,]+),([^,]+),([^,]+)")
    return Vector3.new(tonumber(a), tonumber(b), tonumber(c))
end

